# Copy this file to .env and fill in your own bucket name.
# See SETUP.md for how to create the bucket and IAM credentials.

# Required: your own S3 bucket that the pipeline writes results into.
DEST_BUCKET=your-bucket-name-here

# Optional overrides (defaults shown):
# DEST_PREFIX=processed/noaa-gsod
# SOURCE_BUCKET=noaa-gsod-pds
# SOURCE_YEAR=2024
# SAMPLE_SIZE=50
# AWS_REGION=us-east-1
